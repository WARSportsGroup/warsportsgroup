---
import Mark from './Mark.astro';

export interface NavLink {
  label: string;
  href: string;
}

interface Props {
  nav: NavLink;
}

const { nav } = Astro.props;
---
<header class="site-header">
  <div class="bar">
    <a class="wordmark" href="/" aria-label="WAR Sports Group, home">
      <Mark />
      <span class="wm-text"><b>WAR</b> <i>Sports Group</i></span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href={nav.href}>{nav.label}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hair);
  }
  .bar {
    max-width: var(--shell);
    margin: 0 auto;
    padding: 13px var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--text);
  }
  .wm-text {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .20em;
    text-transform: uppercase;
  }
  .wm-text b {
    font-weight: 500;
  }
  .wm-text i {
    font-style: normal;
    color: var(--faint);
  }
  .nav a {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color .2s ease;
  }
  .nav a:hover {
    color: var(--text);
  }
  @media (prefers-reduced-motion: reduce) {
    .nav a {
      transition: none;
    }
  }
</style>
