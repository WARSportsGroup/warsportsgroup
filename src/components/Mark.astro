---
// The WAR Sports Group mark, drawn from src/lib/mark.ts.
import { markPaths } from '../lib/mark';
---
<svg class="mark" viewBox="0 0 100 100" aria-hidden="true" focusable="false" set:html={markPaths('regular')} />

<style>
  .mark {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    color: var(--text);
    overflow: visible;
  }
</style>
