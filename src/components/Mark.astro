---
<span class="mark" aria-hidden="true"><span></span></span>

<style>
  .mark {
    width: 15px;
    height: 15px;
    position: relative;
    flex: 0 0 auto;
  }
  .mark::before,
  .mark::after {
    content: "";
    position: absolute;
    background: var(--faint);
  }
  .mark::before {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-.5px);
  }
  .mark::after {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    transform: translateY(-.5px);
  }
  .mark span {
    position: absolute;
    inset: 3.5px;
    border: 1px solid var(--accent);
    border-radius: 50%;
  }
</style>
