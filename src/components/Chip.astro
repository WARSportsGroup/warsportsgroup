---
interface Props {
  variant?: 'default' | 'private';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;
---
<span class:list={['chip', { private: variant === 'private' }, className]}><slot /></span>

<style>
  .chip {
    display: inline-block;
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 400;
    letter-spacing: .2em;
    text-transform: uppercase;
    line-height: 1.75;
    color: var(--muted);
    border: 1px solid var(--hair-strong);
    border-radius: 2px;
    padding: 3px 7px;
  }
  .private {
    border-color: var(--accent-line);
    color: var(--accent);
  }
</style>
