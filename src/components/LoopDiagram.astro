---
// A closed loop of steps, drawn top to bottom with a return path on the left.
// House chart rules: grayscale by default, accent on the single step being
// argued for, and a vertical layout so labels stay readable on a phone.
interface Step {
  title: string;
  detail?: string[];
  highlight?: boolean;
}

interface Props {
  steps: Step[];
  label: string;
}

const { steps, label } = Astro.props;

const W = 340;
const NODE_X = 44;
const NODE_W = W - NODE_X - 4;
const GAP = 30;
const RETURN_X = 16;
const TITLE_MID = 18;

const heightOf = (s: Step) => (s.detail?.length ? 54 + 16 * (s.detail.length - 1) : 36);

let y = 2;
const nodes = steps.map((step, i) => {
  const node = { ...step, i, top: y, h: heightOf(step) };
  y += node.h + GAP;
  return node;
});
const H = y - GAP + 2;
const first = nodes[0];
const last = nodes[nodes.length - 1];
const markerId = `loop-arrow-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const pad = (n: number) => String(n).padStart(2, '0');
---
<svg class="loop" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
  <defs>
    <marker id={markerId} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L8 4 L0 8 z" class="head" />
    </marker>
  </defs>

  {nodes.slice(0, -1).map((n) => (
    <line
      class="link"
      x1={NODE_X + NODE_W / 2}
      y1={n.top + n.h + 3}
      x2={NODE_X + NODE_W / 2}
      y2={n.top + n.h + GAP - 4}
      marker-end={`url(#${markerId})`}
    />
  ))}

  <path
    class="link"
    d={`M ${NODE_X - 3} ${last.top + TITLE_MID} H ${RETURN_X} V ${first.top + TITLE_MID} H ${NODE_X - 4}`}
    marker-end={`url(#${markerId})`}
  />

  {nodes.map((n) => (
    <g>
      <rect class:list={['node', { hi: n.highlight }]} x={NODE_X} y={n.top} width={NODE_W} height={n.h} rx="3" />
      <text class="step" x={NODE_X + 14} y={n.top + 22}>{pad(n.i + 1)}</text>
      <text class="title" x={NODE_X + 40} y={n.top + 23}>{n.title}</text>
      {n.detail?.map((d, j) => (
        <text class="detail" x={NODE_X + 40} y={n.top + 41 + j * 16}>{d}</text>
      ))}
    </g>
  ))}
</svg>

<style>
  .loop {
    display: block;
    width: 100%;
    max-width: 400px;
    height: auto;
    margin: 0 auto 22px;
    overflow: visible;
  }
  .node {
    fill: var(--bg);
    stroke: var(--hair-strong);
    stroke-width: 1;
  }
  .node.hi {
    stroke: var(--accent);
  }
  .link {
    fill: none;
    stroke: var(--faint);
    stroke-width: 1;
  }
  .head {
    fill: var(--faint);
  }
  .step {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: .1em;
    fill: var(--faint);
  }
  .title {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 400;
    fill: var(--text);
  }
  .detail {
    font-family: var(--sans);
    font-size: 11.5px;
    font-weight: 300;
    fill: var(--muted);
  }
</style>
