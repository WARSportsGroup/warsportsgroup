---
// House chart style: grayscale by default, accent reserved for the one
// series being argued about, mono labels throughout.
interface Bar {
  label: string;
  value: number;
  display?: string;
  highlight?: boolean;
}

interface Props {
  bars: Bar[];
  // Value that fills the whole track. Defaults to the largest value.
  max?: number;
}

const { bars, max = Math.max(...bars.map((b) => b.value)) } = Astro.props;
const pct = (v: number) => `${Math.max(0, Math.min(100, (v / max) * 100)).toFixed(2)}%`;
---
<div class="chart" data-chart>
  {bars.map((bar) => (
    <div class="bar-row">
      <div class="bar-name">{bar.label}</div>
      <div class="track">
        <div class:list={['fill', { hi: bar.highlight }]} style={`--w: ${pct(bar.value)}`}></div>
        <span class="val">{bar.display ?? String(bar.value)}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .chart {
    margin-bottom: 4px;
  }
  .bar-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    margin-bottom: 18px;
  }
  .bar-name {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.75;
  }
  .track {
    position: relative;
    height: 22px;
    background: var(--track);
    border-radius: 2px;
    overflow: hidden;
  }
  .fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--w);
    background: var(--fill);
    transition: width 1.1s cubic-bezier(.2, .7, .2, 1);
  }
  .fill.hi {
    background: var(--accent);
  }
  :global(.js) .chart:not(.in) .fill {
    width: 0;
  }
  .val {
    position: absolute;
    right: 8px;
    top: 0;
    line-height: 22px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text);
  }
  @media (prefers-reduced-motion: reduce) {
    .fill {
      transition: none;
    }
    :global(.js) .chart:not(.in) .fill {
      width: var(--w);
    }
  }
</style>

<script>
  // Bars grow to their width once, when the chart scrolls into view.
  const charts = document.querySelectorAll('[data-chart]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (still || !('IntersectionObserver' in window)) {
    charts.forEach((c) => c.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.3 },
    );
    charts.forEach((c) => io.observe(c));
  }
</script>
