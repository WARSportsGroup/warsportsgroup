---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Not found" description="That page isn’t on the roster." noindex>
  <div class="lost">
    <p class="code">404</p>
    <h1>That page isn’t on the roster.</h1>
    <a href="/">Back to the index</a>
  </div>
</BaseLayout>

<style>
  .lost {
    padding: 172px 0 60px;
    max-width: var(--measure);
  }
  .code {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: .22em;
    color: var(--accent);
    margin: 0 0 26px;
  }
  h1 {
    font-weight: 500;
    letter-spacing: -.024em;
    color: var(--text-strong);
    margin: 0 0 34px;
    font-size: clamp(31px, 6vw, 46px);
    line-height: 1.12;
  }
  a {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color .2s;
  }
  a:hover {
    color: var(--text);
  }
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
