---
import '../styles/tokens.css';
import '../styles/global.css';
import SiteHeader, { type NavLink } from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME } from '../lib/site';
import { OG_HEIGHT, OG_WIDTH } from '../lib/og';

interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
  nav?: NavLink;
  // Path of this page's share card, e.g. /og/about.png
  ogImage?: string;
  // Article pages pass their publication date.
  published?: Date;
  // The 404 has no canonical address.
  canonical?: boolean;
}

const {
  title,
  description,
  noindex = false,
  nav = { label: 'About', href: '/about' },
  ogImage = '/og/home.png',
  published,
  canonical = true,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const pageUrl = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
const imageUrl = new URL(ogImage, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={title ?? SITE_NAME} />
    {published && <meta property="article:published_time" content={published.toISOString().slice(0, 10)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <SiteHeader nav={nav} />
    <main class="shell">
      <slot />
    </main>
    <SiteFooter nav={nav} />
    <script>
      // Sections and index rows fade up once on entry.
      const items = document.querySelectorAll('.reveal');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
